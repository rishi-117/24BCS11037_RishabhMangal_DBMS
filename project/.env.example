# Copy to .env.local and fill in the values. Never commit credentials.
# Use a pooled PostgreSQL URL for serverless deployments.
DATABASE_URL=
# Required only when seeding demo data or running API integration tests.
DEMO_PASSWORD=
# Optional: require TLS for migration/reset scripts on a hosted database.
PGSSLMODE=
# Optional maximum number of connections per server process (default 5).
PG_POOL_MAX=
# Optional public site URL used in metadata.
NEXT_PUBLIC_APP_URL=
