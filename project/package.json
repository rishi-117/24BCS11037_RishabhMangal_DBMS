{
  "name": "aura-athletic-erp",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local db/migrate.mjs",
    "db:seed": "node --env-file=.env.local db/seed.mjs",
    "db:reset": "node --env-file=.env.local db/reset.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "test:smoke": "playwright test tests/smoke",
    "test:api": "node --env-file=.env.local ./node_modules/@playwright/test/cli.js test tests/api",
    "test:smoke:ui": "playwright test tests/smoke --ui"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.2",
    "html5-qrcode": "^2.3.8",
    "next": "16.1.6",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
